{
  "name": "edm-sink",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "edm.product",
    "connection.url": "jdbc:postgresql://postgres-target:5432/targetdb",
    "connection.username": "postgres",
    "connection.password": "postgres",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "primary.key.fields": "_entity_key",
    "schema.evolution": "basic",
    "collection.name.format": "edm.${topic}",
    "transforms": "key,entity,created_at,updated_at,placed_at,registered_at,processed_at",
    "transforms.key.type": "org.apache.kafka.connect.transforms.HoistField$Key",
    "transforms.key.field": "_entity_key",
    "transforms.entity.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.entity.regex": "edm\\.(.*)",
    "transforms.entity.replacement": "$1",
    "transforms.created_at.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.created_at.field": "created_at",
    "transforms.created_at.unix.precision": "microseconds",
    "transforms.created_at.target.type": "Timestamp",
    "transforms.updated_at.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.updated_at.field": "updated_at",
    "transforms.updated_at.unix.precision": "microseconds",
    "transforms.updated_at.target.type": "Timestamp",
    "transforms.placed_at.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.placed_at.field": "placed_at",
    "transforms.placed_at.unix.precision": "microseconds",
    "transforms.placed_at.target.type": "Timestamp",
    "transforms.registered_at.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.registered_at.field": "registered_at",
    "transforms.registered_at.unix.precision": "microseconds",
    "transforms.registered_at.target.type": "Timestamp",
    "transforms.processed_at.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.processed_at.field": "_processed_at",
    "transforms.processed_at.unix.precision": "microseconds",
    "transforms.processed_at.target.type": "Timestamp"
  }
}
